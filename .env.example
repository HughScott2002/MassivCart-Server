# ── Supabase ──────────────────────────────────────────────────────────────────
# Defaults target the LOCAL stack (`make db` / `supabase start`). These local
# development keys are deterministic on every machine — safe to commit.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU   # never expose to browser
# Cloud project instead? Swap the three values above for your project's.
# Running the API in docker against cloud? Also set:
# COMPOSE_SUPABASE_URL=https://<project-ref>.supabase.co

# ── OpenRouter (receipt vision OCR) ───────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-...
# Optional override; defaults to google/gemini-3-flash-preview (see src/vision/).
OPENROUTER_MODEL=

# ── Anthropic (still used by /api/command parsing + synthetic data; issue #10) ─
ANTHROPIC_API_KEY=sk-ant-...

# ── LLM provider (command parsing) ────────────────────────────────────────────
LLM_PROVIDER=claude          # "claude" | "ollama" (ollama requires a local GPU)

# ── Command search mode ───────────────────────────────────────────────────────
# Set to "true" to route /api/command through Claude NLP.
# Default (unset): fast programmatic parser — no LLM tokens consumed.
COMMAND_LLM=

# ── Google Places ─────────────────────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=<google-places-api-key>
PLACES_SYNC_SECRET=<random-hex>   # protects /api/admin/* routes; match frontend value

# ── Redis (optional) ──────────────────────────────────────────────────────────
# Upstash REST cache. Leave unset to run with caching disabled.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000
NODE_ENV=development
